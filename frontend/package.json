{
  "name": "futures-ai-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "tokens": "node scripts/tokens-build.mjs",
    "tokens:check": "node scripts/tokens-build.mjs --check",
    "contract": "node scripts/contract-build.mjs",
    "check": "node scripts/check.mjs",
    "test": "pnpm check && pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:e2e"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "pinia": "^3.0.0",
    "vue": "~3.5.44",
    "vue-router": "^4.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^25.9.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "typescript": "5.9.2",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
